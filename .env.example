APP_NAME=Personal Finance API
APP_ENV=development
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///./finpilot_dev.db
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=finpilot
SAFETY_BUFFER_RATE=0.08
SAFETY_BUFFER_MINIMUM=5000
SESSION_COOKIE_NAME=finpilot_session
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_SECONDS=86400
MAX_REQUEST_BYTES=65536

# Backend only. Never use NEXT_PUBLIC_ for these settings.
# Safe default: deterministic local coach. Set openai explicitly to enable API calls.
AI_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-sol
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=1800
AI_MAX_TOOL_ROUNDS=4
